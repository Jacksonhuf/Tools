# Vercel 演示环境（最小配置）
# 适用于 https://tools-bff.vercel.app — 内存数据、无需真实 Postgres/Redis
#
# 在 Vercel 控制台添加：
#   Project → tools-bff → Settings → Environment Variables → Production
# 添加后点击 Deployments → 最新部署 → Redeploy（或等 Git 推送自动部署）

# --- 必填：认证（解决 401 / adapter status 401）---
AUTH_DRIVER=oidc_jwt
# 任意随机字符串，建议 32 字符以上（在 Vercel 勾选 Sensitive）
OIDC_JWT_HS256_SECRET=请替换为随机密钥-例如-openssl-rand-hex-32-的输出
BROWSER_DEMO_AUTH=1

# --- 建议：基础部署标识 ---
DEPLOY_ENV=production
NODE_ENV=production
PRODUCTION_MODE=true

# --- 建议：允许前端域名跨域 ---
CORS_ALLOWED_ORIGINS=https://tools-bff.vercel.app

# --- 渠道凭证加密（部分功能需要，可先用占位）---
SHOP_CREDENTIAL_ENCRYPTION_KEY=请替换为32字节密钥-可用-openssl-rand-hex-16

# --- 不要设置（演示模式使用内存数据库）---
# VERCEL_USE_PG=1
# DATABASE_URL=...
