# Production environment profile
DEPLOY_ENV=production
PRODUCTION_MODE=true
AUTH_DRIVER=oidc_jwt
DATABASE_URL=postgresql://user:pass@prod-host:5432/mx_pricing
REDIS_URL=redis://prod-redis:6379

OIDC_JWT_HS256_SECRET=use-secrets-manager
# OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
SHOP_CREDENTIAL_ENCRYPTION_KEY=use-secrets-manager-32-byte-key

WAF_ENABLED=true
WAF_RATE_LIMIT_PER_MINUTE=600
WAF_MAX_BODY_BYTES=1048576
CORS_ALLOWED_ORIGINS=https://app.example.com

BACKUP_ENABLED=true
PITR_ENABLED=true
BACKUP_CRON_SCHEDULE=0 1 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LAST_COMPLETED_AT=2026-01-01T00:00:00.000Z

EXPORT_S3_BUCKET=mx-pricing-exports
EXPORT_S3_ENDPOINT=https://s3.amazonaws.com
EXPORT_S3_ACCESS_KEY_ID=use-secrets-manager
EXPORT_S3_SECRET_ACCESS_KEY=use-secrets-manager

CHANNEL_ADAPTER_DRIVER=live
CHANNEL_LIVE_ACKNOWLEDGED=true

RULE_COMPILER_DRIVER=llm_http
RULE_COMPILER_LLM_ENDPOINT=https://llm.example.com/compile
RULE_COMPILER_LLM_API_KEY=use-secrets-manager
RULE_COMPILER_PRODUCTION_NO_FALLBACK=true

ML_CLIENT_ID=use-secrets-manager
ML_CLIENT_SECRET=use-secrets-manager
AMAZON_LWA_APP_ID=use-secrets-manager
AMAZON_LWA_CLIENT_SECRET=use-secrets-manager
