# Staging environment profile
DEPLOY_ENV=staging
PRODUCTION_MODE=false
AUTH_DRIVER=oidc_jwt
DATABASE_URL=postgresql://mx:mx_staging_secret@localhost:5433/mx_pricing_staging
REDIS_URL=redis://localhost:6380

OIDC_JWT_HS256_SECRET=change-me-staging-jwt-secret
SHOP_CREDENTIAL_ENCRYPTION_KEY=change-me-staging-shop-key-32chars!!

WAF_ENABLED=true
WAF_RATE_LIMIT_PER_MINUTE=300
CORS_ALLOWED_ORIGINS=https://staging.example.com

BACKUP_ENABLED=true
PITR_ENABLED=true
PITR_WAL_ARCHIVE_DIR=./backups/wal-archive
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14

CHANNEL_ADAPTER_DRIVER=live
CHANNEL_LIVE_ACKNOWLEDGED=true
