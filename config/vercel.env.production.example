# Vercel Production Environment Variables
# Copy keys into: Vercel Dashboard → Project → Settings → Environment Variables → Production
# Never commit real values. Use Vercel "Sensitive" for secrets.

# --- Core deploy profile ---
DEPLOY_ENV=production
PRODUCTION_MODE=true
NODE_ENV=production

# --- Database & cache (required) ---
DATABASE_URL=postgresql://user:pass@host:5432/mx_pricing
REDIS_URL=redis://user:pass@host:6379

# --- Auth (required) ---
AUTH_DRIVER=oidc_jwt
OIDC_JWT_HS256_SECRET=use-vercel-sensitive-secret
# Issue short-lived JWTs for the SPA on Vercel demo deploys (auto when VERCEL=1 and VERCEL_USE_PG is unset).
# Set to 0 to disable and wire your own IdP / VITE_API_BEARER_TOKEN at build time.
BROWSER_DEMO_AUTH=1
# OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
SHOP_CREDENTIAL_ENCRYPTION_KEY=use-vercel-sensitive-32-byte-key

# --- Security / WAF ---
WAF_ENABLED=true
WAF_RATE_LIMIT_PER_MINUTE=600
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://app.example.com

# --- Export storage (required in production) ---
EXPORT_S3_BUCKET=mx-pricing-exports
EXPORT_S3_ENDPOINT=https://s3.amazonaws.com
EXPORT_S3_ACCESS_KEY=use-vercel-sensitive-secret

# --- Channel adapters ---
CHANNEL_ADAPTER_DRIVER=live
CHANNEL_LIVE_ACKNOWLEDGED=true
ML_CLIENT_ID=use-vercel-sensitive-secret
ML_CLIENT_SECRET=use-vercel-sensitive-secret

# --- LLM rule compiler ---
RULE_COMPILER_DRIVER=llm_http
RULE_COMPILER_LLM_ENDPOINT=https://llm.example.com/compile
RULE_COMPILER_LLM_API_KEY=use-vercel-sensitive-secret
RULE_COMPILER_PRODUCTION_NO_FALLBACK=true

# --- Backup metadata (set after first drill) ---
BACKUP_ENABLED=true
PITR_ENABLED=true
BACKUP_LAST_COMPLETED_AT=2026-01-01T00:00:00.000Z
