{
  "name": "mx-pricing",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:smoke": "vitest run tests/e2e/smoke-flow.test.ts tests/e2e/p3-smoke.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:golden": "vitest run tests/golden/golden.test.ts",
    "test:nfr": "vitest run tests/nfr/",
    "test:nfr-rel": "vitest run tests/api/ingest-nfr.test.ts -t \"TC-NFR-REL-003\"",
    "test:release-gate": "npm run test:golden && npm run test:api && vitest run tests/api/repricing-guards.test.ts tests/api/ingest-nfr.test.ts -t \"TC-NFR-REL-003\"",
    "nfr:baseline": "node scripts/nfr/node-load-baseline.mjs",
    "security:scan": "node scripts/security/scan-secrets.mjs",
    "secrets:validate": "node scripts/secrets/validate-env.mjs",
    "staging:bootstrap": "node scripts/staging/bootstrap.mjs",
    "staging:smoke": "node scripts/staging/smoke.mjs",
    "staging:smoke:start": "node scripts/staging/smoke.mjs --start-bff",
    "backup:dump": "node scripts/backup/pg-backup.mjs",
    "backup:drill": "node scripts/backup/pg-restore-drill.mjs",
    "test:api": "vitest run tests/api/bff.test.ts",
    "test:int-channel": "vitest run tests/api/shops.test.ts tests/api/channel-publish.test.ts tests/api/channel-publish-batch.test.ts tests/api/publish-idempotency.test.ts tests/api/competitor-ingest.test.ts tests/api/dynamic-rules.test.ts tests/api/repricing-events.test.ts tests/api/ingest-nfr.test.ts",
    "build": "npm run build -w @mx-pricing/pricing-engine && npm run build -w @mx-pricing/i18n-format && npm run build -w @mx-pricing/channel-adapters && npm run build -w @mx-pricing/db && npm run build -w @mx-pricing/bff && npm run build -w @mx-pricing/web",
    "build:vercel": "npm run build",
    "deploy:vercel": "bash scripts/vercel-deploy.sh",
    "deploy:vercel:prod": "bash scripts/vercel-deploy.sh --prod",
    "vercel:check-env": "DEPLOY_ENV=${DEPLOY_ENV:-production} node scripts/secrets/validate-env.mjs",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run build -w @mx-pricing/db && DATABASE_URL=${DATABASE_URL:-postgresql://mx:mx@localhost:5432/mx_pricing} node packages/db/dist/migrate-cli.js",
    "dev:web": "npm run dev -w @mx-pricing/web",
    "dev:bff": "npm run start -w @mx-pricing/bff",
    "dev:channel-gateway": "node tools/channel-gateway-sidecar/server.mjs",
    "repricing-batch:worker": "node tools/repricing-batch-worker/run.mjs",
    "dev:async-worker": "node tools/async-worker/run.mjs",
    "repricing-event:worker": "node tools/repricing-event-worker/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "pg-mem": "^3.0.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
